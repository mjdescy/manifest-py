{
  "name": "Python + Typer (uv)",
  "image": "mcr.microsoft.com/devcontainers/python:3.15",
  "postCreateCommand": "pipx install uv && uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}